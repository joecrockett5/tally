# ---- Tally configuration -------------------------------------------------
# Copy to .env and adjust. Never commit .env.

# Image tag to run: latest, or a release such as 1.0.0, 1.0 or 1.
VERSION=latest

# Postgres credentials (used by both containers). Change the password!
# Use letters and digits only: it is also embedded in the app's connection string.
POSTGRES_USER=tally
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=tally

# HTTPS port, inside and outside the container: open https://<server>:<HTTPS_PORT>.
# Tally makes its own self-signed certificate on first start.
HTTPS_PORT=8443
# The addresses you open Tally at (IPs or names, comma-separated), so the
# self-signed certificate covers them. Changing this makes a new certificate.
TALLY_HOSTS=
# Plain HTTP port, inside and outside the container. The camera doesn't work
# over it; use it for a reverse proxy (http://<docker-host>:<APP_PORT>).
APP_PORT=8080

# IANA timezone that decides which calendar day "today" is.
TALLY_TIMEZONE=Europe/London

# Open Food Facts asks every app to identify itself with a contact email,
# sent in the User-Agent: "Tally/<version> (<email>)".
OFF_CONTACT_EMAIL=you@example.com
# Set to false to disable all online lookups (local + CoFID data only).
OFF_ENABLED=true

# Cache lifetimes for Open Food Facts data.
# Products are served from cache and refreshed in the background after this many days.
OFF_PRODUCT_CACHE_DAYS=30
# "Barcode not found" results are remembered for this many hours.
OFF_NOT_FOUND_CACHE_HOURS=24
# Text search results are remembered for this many hours.
OFF_SEARCH_CACHE_HOURS=24

# Only used by docker-compose.build.yml: the version stamped into a local build.
# APP_VERSION=dev
