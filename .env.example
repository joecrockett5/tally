# ---- Tally configuration -------------------------------------------------
# Copy to .env and adjust. Never commit .env.

# Postgres credentials (used by both containers). Change the password!
POSTGRES_USER=tally
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=tally

# HTTP port the app listens on, inside and outside the container.
# Point Nginx Proxy Manager at http://<docker-host>:<APP_PORT>.
APP_PORT=8080

# IANA timezone that decides which calendar day "today" is.
TALLY_TIMEZONE=Europe/London

# Open Food Facts asks every app to identify itself with a contact email,
# sent in the User-Agent: "Tally/<version> (<email>)".
OFF_CONTACT_EMAIL=you@example.com
# Set to false to disable all online lookups (local + CoFID data only).
OFF_ENABLED=true

# Cache lifetimes for Open Food Facts data.
# Products are served from cache and refreshed in the background after this many days.
OFF_PRODUCT_CACHE_DAYS=30
# "Barcode not found" results are remembered for this many hours.
OFF_NOT_FOUND_CACHE_HOURS=24
# Text search results are remembered for this many hours.
OFF_SEARCH_CACHE_HOURS=24
